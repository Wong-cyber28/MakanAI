{
  "expo": {
    "name": "MakanAI",
    "slug": "makanai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "makanai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F5DC",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.ying.init.makanai",
      "intentFilters": [
        {
          "action": "VIEW",
          "category": ["BROWSABLE", "DEFAULT"],
          "data": [
            {
              "scheme": "makanai"
            }
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow MakanAI to access your camera to photograph meals.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow MakanAI to access your photos to set a profile picture.",
          "cameraPermission": "Allow MakanAI to access your camera to photograph meals.",
          "microphonePermission": false
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F5DC",
          "image": "./assets/images/icon.png",
          "imageWidth": 200
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6bceb9b6-74f4-46b9-8283-1e7b0401dd1b"
      },
      "supabaseUrl": "https://efkkdohscemtjdxgmvtb.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVma2tkb2hzY2VtdGpkeGdtdnRiIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgxNjgyMTgsImV4cCI6MjEwMzc0NDIxOH0.BPIOWnThrWMFHuk31q5yYJHY-UmufHWBKPf8e1029eY"
    },
    "owner": "yinginits-team"
  }
}
